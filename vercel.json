{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "115brew.com"
        }
      ],
      "destination": "/115brew/index.html"
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "115brew.com"
        }
      ],
      "destination": "/115brew/admin/index.html"
    },
    {
      "source": "/admin/",
      "has": [
        {
          "type": "host",
          "value": "115brew.com"
        }
      ],
      "destination": "/115brew/admin/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "115brew.com"
        }
      ],
      "destination": "/115brew/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.115brew.com"
        }
      ],
      "destination": "/115brew/index.html"
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "www.115brew.com"
        }
      ],
      "destination": "/115brew/admin/index.html"
    },
    {
      "source": "/admin/",
      "has": [
        {
          "type": "host",
          "value": "www.115brew.com"
        }
      ],
      "destination": "/115brew/admin/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.115brew.com"
        }
      ],
      "destination": "/115brew/:path*"
    }
  ]
}
